#!/data/data/com.termux/files/usr/bin/bash
# hm-shizuku: lets Shizuku start again by itself after a restart or a crash, without root (Android 11+, Wi-Fi).
# Runs in TERMUX (phone/install.sh puts it in ~/bin). Termux gets its own adb (android-tools), paired once with the
# phone's Wireless debugging; afterwards Hermes Mobile turns Wireless debugging on when Shizuku is down and runs
# `hm-shizuku start <port>`, which starts Shizuku's server the way Shizuku's own "Start by adb" does.
#
#   hm-shizuku pair [--force]  Needs Shizuku running (rish) and Wi-Fi. Opens Settings → Wireless debugging → "Pair device
#                              with pairing code" for a few seconds, reads the code and port from the screen, pairs
#                              Termux's adb, puts the screen back. Turns Wireless debugging off again if it turned it on.
#                              Already paired: returns at once (--force pairs again). Exit 0 = paired.
#   hm-shizuku start [port]    Needs Wireless debugging on. Connects to 127.0.0.1:<port> (the app finds the port; without
#                              one, or if it doesn't answer, it scans the loopback ports, ~1-20 s) and starts Shizuku's
#                              server. Exit 0 only when shizuku_server runs. Never prompts.
#   hm-shizuku status          Prints "paired" or "unpaired", then "adb=ok" or "adb=missing".
#
# After pair/start it tells the app, like the Hermes plugin does: POST {"kind":"shizuku-auto","paired":bool,
# "result":"ok|no-wifi|untrusted-network|no-port|failed|not-paired","detail":"…"} to 127.0.0.1:9121/event with the key
# from ~/.hermes-mobile/key (no key: nothing is sent). Every rish/adb call is bounded (timeout) and gets </dev/null.
# Screens are found by Android's resource ids (AOSP Settings/SystemUI); a screen that doesn't match stops with
# "… not recognised" and a non-zero exit, so the app offers Set up again. Log: ~/.hermes-mobile/hm-shizuku.log.
# Exit: 0 ok, 2 Shizuku/rish/adb missing or Android 10 and older, 3 not on Wi-Fi, 4 network not allowed, 5 screen not
# recognised, 6 adb pair failed, 7 no Wireless debugging port, 8 server didn't start, 9 not paired, 10 busy, 64 usage.
set -u
HM="$HOME/.hermes-mobile"
RISH="${RISH:-$HOME/bin/rish}"
MARK="$HM/adb-paired"
LOGF="$HM/hm-shizuku.log"
EVENT_URL="http://127.0.0.1:9121/event"
NAP="${HM_SHIZUKU_NAP:-1}"                      # tests set 0 (no sleeps)
SCAN_FROM="${HM_SCAN_FROM:-32768}"; SCAN_TO="${HM_SCAN_TO:-60999}"   # Linux's ephemeral range (adbd binds port 0)
KEYDIR="${ANDROID_USER_HOME:-$HOME/.android}"
SHIZUKU_PKG=moe.shizuku.privileged.api
SETTINGS_PKG=com.android.settings
CMD="${1:-}"
mkdir -p "$HM"

nap() { [ "$NAP" = 0 ] || sleep "$1"; }
log() {
  echo "hm-shizuku: $*"
  echo "$(date '+%Y-%m-%d %H:%M:%S') $CMD: $*" >> "$LOGF" 2>/dev/null
}
# One shell-uid command through Shizuku, bounded. rish answers "Request timeout" while the Shizuku app is frozen in the
# background, so it is tried 3 times. </dev/null: `timeout` puts rish in its own process group and a terminal read
# would stop it.
r() {
  local i out
  for i in 1 2 3; do
    out=$(timeout -s KILL 20 "$RISH" -c "$1" </dev/null 2>/dev/null) && { printf '%s\n' "$out"; return 0; }
    nap 1
  done
  return 1
}
A() { timeout -s KILL "${TO:-10}" adb "$@" </dev/null 2>&1; }   # Termux's adb, bounded
# A read through rish: rish now and then exits 0 with no output at all, so an empty answer is tried again too.
rv() { local i out; for i in 1 2 3 4 5; do out=$(r "$1") && [ -n "$out" ] && { printf '%s\n' "$out"; return 0; }; nap 1; done; return 1; }
have_adb() { command -v adb >/dev/null 2>&1; }
keysum() { [ -s "$KEYDIR/adbkey.pub" ] && cksum < "$KEYDIR/adbkey.pub" | awk '{print $1}'; }
# Paired = this script (or a start) saw the phone accept the adb key that is in ~/.android now.
paired_now() { local k; k=$(keysum) && [ -n "$k" ] && [ -s "$MARK" ] && [ "$(awk '{print $2}' "$MARK")" = "$k" ]; }
mark_paired() { echo "$(date +%s) $(keysum)" > "$MARK"; }

jstr() {   # JSON string
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=$(printf '%s' "$s" | tr '\n\r\t' '   ' | tr -d '\000-\037')
  printf '"%s"' "$s"
}
emit() {   # emit <result> <detail>: tell the app (best effort, 2 s)
  local key paired=false
  key=$(cat "$HM/key" 2>/dev/null) || return 0
  [ -n "$key" ] && command -v curl >/dev/null 2>&1 || return 0
  paired_now && paired=true
  printf '{"kind":"shizuku-auto","paired":%s,"result":%s,"detail":%s}' "$paired" "$(jstr "$1")" "$(jstr "$2")" |
    curl -s -m 2 -o /dev/null -X POST -H 'Content-Type: application/json' \
      -H @<(printf 'X-Hermes-Mobile-Key: %s\n' "$key") --data-binary @- "$EVENT_URL" 2>/dev/null || true
}
# finish <result> <exit code> <detail>: put the screen back (pair), tell the app, exit.
finish() {
  [ "$CMD" = pair ] && restore
  if [ "$2" = 0 ]; then log "$3"; else log "FAIL ($1) $3"; fi
  emit "$1" "$3"
  exit "$2"
}

# ── screen helpers (pair) ──
# uiautomator's XML, one <node …> per line.
dump() {
  local d
  d=$(rv 'uiautomator dump /dev/stdout 2>/dev/null')
  case "$d" in *"<hierarchy"*) ;; *) d=$(rv 'f=/data/local/tmp/hm-shizuku-ui.xml; uiautomator dump $f >/dev/null 2>&1 && cat $f; rm -f $f') ;; esac
  printf '%s\n' "$d" | tr '>' '\n'
}
attr() { sed -n "s/.* $1=\"\([^\"]*\)\".*/\1/p"; }            # attribute of each node line on stdin
with_id() { grep "resource-id=\"$1\""; }
tap_node() {   # tap the middle of the first node line on stdin
  local xy
  xy=$(sed -n 's/.*bounds="\[\([0-9]*\),\([0-9]*\)\]\[\([0-9]*\),\([0-9]*\)\]".*/\1 \2 \3 \4/p' | head -1 |
       awk '{printf "%d %d", ($1+$3)/2, ($2+$4)/2}')
  [ -n "$xy" ] && r "input tap $xy" >/dev/null
}
settings_in_front() { rv 'dumpsys window | grep -E "mCurrentFocus|mFocusedApp"; true' | head -1 | grep -q "$SETTINGS_PKG/"; }
wd_state() { rv 'settings get global adb_wifi_enabled' | tr -d '\r '; }
wait_wd_on() { local i; for i in 1 2 3 4; do nap 1; [ "$(wd_state)" = 1 ] && return 0; done; return 1; }

OPENED=""; WE_TURNED_ON=""; RESTORED=""
restore() {
  [ -z "$RESTORED" ] || return 0; RESTORED=1
  # Close the Settings screen this run opened, only if it is still in front. Not with Back: Settings opened through the
  # tile intent shows Wireless debugging again on Back. Stopping Settings closes it (and the pairing dialog) and brings
  # back the app that was in front before; Home only if Settings is somehow still there.
  if [ -n "$OPENED" ] && settings_in_front; then
    r "am force-stop $SETTINGS_PKG" >/dev/null; nap 1
    settings_in_front && r 'input keyevent HOME' >/dev/null
  fi
  # Turn Wireless debugging off again only if this run turned it on (Shizuku keeps running without it).
  [ -n "$WE_TURNED_ON" ] && r 'settings put global adb_wifi_enabled 0' >/dev/null
  return 0
}

# Android asks "Allow wireless debugging on this network?" (SystemUI) on a network it doesn't know yet and leaves the
# setting at 0 until it is answered. The user started the pairing, so tick "Always allow on this network" and Allow.
answer_trust_dialog() {
  local d
  d=$(dump)
  echo "$d" | with_id android:id/alwaysUse | grep -q . || return 1
  echo "$d" | with_id android:id/alwaysUse | grep -q 'checked="true"' || echo "$d" | with_id android:id/alwaysUse | tap_node
  nap 0.5
  echo "$d" | with_id android:id/button1 | tap_node || return 1
  log "allowed wireless debugging on this network"
  wait_wd_on
}

cmd_pair() {
  local force="${1:-}" sdk d i connect line code addr out
  [ -z "$force" ] || [ "$force" = --force ] || usage
  have_adb || finish failed 2 "adb is missing (pkg install android-tools)"
  sdk=$(getprop ro.build.version.sdk 2>/dev/null)
  [ -n "$sdk" ] && [ "$sdk" -lt 30 ] 2>/dev/null && finish failed 2 "Wireless debugging needs Android 11 or newer: start Shizuku from a computer after a restart"
  A start-server >/dev/null   # makes ~/.android/adbkey on first use
  if [ -z "$force" ] && paired_now; then finish ok 0 "already paired"; fi
  [ -x "$RISH" ] || finish failed 2 "rish is missing: run the Hermes Mobile installer again"
  rv id | grep -q 'uid=2000' || finish failed 2 "Shizuku isn't running, or Termux isn't allowed to use it"
  out=$(rv 'cmd wifi status')
  if echo "$out" | grep -qi 'wifi is connected'; then :
  elif echo "$out" | grep -qi 'wifi is'; then finish no-wifi 3 "not on Wi-Fi: connect to Wi-Fi and try again"
  fi   # other output: carry on, Android itself refuses Wireless debugging off Wi-Fi
  [ "$(rv 'settings get global development_settings_enabled' | tr -d '\r ')" = 1 ] ||
    { r 'settings put global development_settings_enabled 1' >/dev/null; log "developer options turned on"; }

  if [ "$(wd_state)" != 1 ]; then
    r 'settings put global adb_wifi_enabled 1' >/dev/null; WE_TURNED_ON=1
    wait_wd_on || answer_trust_dialog ||
      finish untrusted-network 4 "Wireless debugging stays off: on this Wi-Fi, allow wireless debugging (Always allow on this network, then Allow)"
    log "wireless debugging on"
  fi

  # Settings → Wireless debugging. The Quick Settings tile's "long press" intent opens it directly (Settings' inner
  # screens can't be started from the shell). It needs developer options on. A fresh task each time (clear-task), so
  # Back closes it again instead of uncovering screens left over from an earlier run.
  r "am start --activity-clear-task -a android.service.quicksettings.action.QS_TILE_PREFERENCES -n '$SETTINGS_PKG/.Settings\$DevelopmentSettingsActivity' --ecn android.intent.extra.COMPONENT_NAME '$SETTINGS_PKG/.development.qstile.DevelopmentTiles\$WirelessDebugging'" >/dev/null
  OPENED=1
  # The list fills in after the screen shows: wait for the "IP address & Port" value.
  connect=""
  for i in 1 2 3 4 5 6 7 8; do
    nap 1; d=$(dump)
    connect=$(echo "$d" | with_id android:id/summary | attr text | grep -Eo '^[0-9a-fA-F.:]+:[0-9]+$' | head -1)
    [ -n "$connect" ] && break
  done
  [ -n "$connect" ] || finish failed 5 "Wireless debugging screen not recognised"
  log "wireless debugging screen open ($connect)"

  # "Pair device with pairing code": by its title; else the 4th entry (AOSP order: device name, IP address & port,
  # QR code, pairing code). A wrong tap is caught below: the dialog must have the pairing code ids.
  line=$(echo "$d" | with_id android:id/title | grep -i 'pairing code' | head -1)
  [ -n "$line" ] || line=$(echo "$d" | with_id android:id/title | sed -n 4p)
  [ -n "$line" ] && echo "$line" | tap_node || finish failed 5 "pairing screen not recognised (no 'Pair device with pairing code')"
  code=""; addr=""
  for i in 1 2 3; do
    nap 1; d=$(dump)
    code=$(echo "$d" | with_id "$SETTINGS_PKG:id/pairing_code" | attr text | tr -d ' ' | head -1)
    addr=$(echo "$d" | with_id "$SETTINGS_PKG:id/ip_addr" | attr text | head -1)
    [ -n "$code" ] && [ -n "$addr" ] && break
  done
  echo "$code" | grep -Eq '^[0-9]{6}$' && echo "$addr" | grep -Eq ':[0-9]+$' ||
    finish failed 5 "pairing screen not recognised (no pairing code on it)"
  log "pairing code shown (port ${addr##*:})"

  # Pair over loopback (the phone pairs with itself; no Wi-Fi address needed).
  out=$(TO=20 A pair "127.0.0.1:${addr##*:}" "$code")
  echo "$out" | grep -q 'Successfully paired' || finish failed 6 "adb pair failed: $(echo "$out" | tail -1)"
  mark_paired
  finish ok 0 "paired"
}

# ── start ──
SERIAL=""; UNAUTH=""
try_port() {   # connect to 127.0.0.1:<port> and prove it is adbd (shell uid); sets SERIAL
  local s="127.0.0.1:$1" out id
  out=$(TO=6 A connect "$s")
  case "$out" in
    *"connected to"*) ;;
    *authenticat*|*unauthorized*) UNAUTH=1; A disconnect "$s" >/dev/null; return 1 ;;
    *) A disconnect "$s" >/dev/null; return 1 ;;
  esac
  id=$(TO=8 A -s "$s" shell id -u | tr -d '\r')
  [ "$id" = 2000 ] && { SERIAL=$s; return 0; }
  case "$id" in *authenticat*|*unauthorized*) UNAUTH=1 ;; esac
  A disconnect "$s" >/dev/null; return 1
}
# Open loopback ports in the ephemeral range. Termux's adb has no mDNS and apps can't read /proc/net/tcp, so this is
# the only way without the app's port. In-process connects (no fork per port); runs in its own subshell.
scan() { local p=$SCAN_FROM; while [ "$p" -le "$SCAN_TO" ]; do { exec 3<>"/dev/tcp/127.0.0.1/$p"; } 2>/dev/null && { exec 3>&-; echo "$p"; }; p=$((p+1)); done; }
server_up() { TO=8 A -s "$SERIAL" shell ps -A -o NAME | tr -d '\r' | grep -q '^shizuku_server'; }

cmd_start() {
  local port="${1:-}" ports p out i
  [ -z "$port" ] || echo "$port" | grep -Eq '^[0-9]{1,5}$' || usage
  have_adb || finish failed 2 "adb is missing (pkg install android-tools)"
  A start-server >/dev/null
  [ -n "$port" ] && { try_port "$port" || log "port $port: no adbd there, scanning"; }
  if [ -z "$SERIAL" ]; then
    ports=$(scan)
    log "open loopback ports: $(echo $ports)"
    for p in $ports; do [ "$p" = "$port" ] && continue; try_port "$p" && break; done
  fi
  if [ -z "$SERIAL" ]; then
    if [ -n "$UNAUTH" ]; then
      rm -f "$MARK"
      finish not-paired 9 "Wireless debugging refused Termux's adb key: pair again (Setup check → Set up)"
    fi
    finish no-port 7 "no Wireless debugging port answered (is Wireless debugging on?)"
  fi
  paired_now || mark_paired   # the phone accepted the key: it is paired (also when paired by hand)
  if server_up; then A disconnect "$SERIAL" >/dev/null; finish ok 0 "Shizuku was already running"; fi
  # Shizuku's own adb start command, with whichever ABI folder the phone extracted.
  out=$(TO=30 A -s "$SERIAL" shell 'p=$(pm path '"$SHIZUKU_PKG"' | head -1 | cut -d: -f2); d=$(dirname "$p"); for f in "$d"/lib/*/libshizuku.so; do [ -e "$f" ] && exec "$f"; done; echo "Shizuku is not installed (no libshizuku.so)"; exit 1')
  for i in 1 2 3 4 5; do
    server_up && { A disconnect "$SERIAL" >/dev/null; finish ok 0 "Shizuku started ($SERIAL)"; }
    nap 1
  done
  A disconnect "$SERIAL" >/dev/null
  finish failed 8 "Shizuku's server didn't start: $(echo "$out" | grep . | tail -1)"
}

cmd_status() {
  if paired_now; then echo paired; else echo unpaired; fi
  if have_adb; then echo adb=ok; else echo adb=missing; fi
}

usage() { echo "usage: hm-shizuku pair [--force] | start [port] | status" >&2; exit 64; }

# One pair/start at a time (the app may start one while another runs).
lock() {
  local L="$HM/hm-shizuku.lock" pid
  if ! mkdir "$L" 2>/dev/null; then
    pid=$(cat "$L/pid" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && ps -o args= -p "$pid" 2>/dev/null | grep -q hm-shizuku; then log "busy: another hm-shizuku run ($pid) reports the result"; exit 10; fi
    rm -rf "$L"; mkdir "$L" 2>/dev/null || exit 10
  fi
  echo $$ > "$L/pid"
  trap 'rm -rf "'"$L"'"; tail -n 300 "$LOGF" > "$LOGF.tmp" 2>/dev/null && mv "$LOGF.tmp" "$LOGF"' EXIT
}

case "$CMD" in
  pair) [ $# -le 2 ] || usage; lock; cmd_pair "${2:-}" ;;
  start) [ $# -le 2 ] || usage; lock; cmd_start "${2:-}" ;;
  status) cmd_status ;;
  *) usage ;;
esac
