#!/data/data/com.termux/files/usr/bin/bash
# hm-shizuku: lets Shizuku start again by itself after a restart or a crash, without root (Android 11+, Wi-Fi).
# Runs in TERMUX (phone/install.sh puts it in ~/bin). Termux gets its own adb (android-tools), paired once with the
# phone's Wireless debugging; afterwards Hermes Mobile turns Wireless debugging on when Shizuku is down and runs
# `hm-shizuku start <port>`, which starts Shizuku's server the way Shizuku's own "Start by adb" does.
#
#   hm-shizuku pair PORT CODE  Pairs Termux's adb with Wireless debugging: the user opened "Pair device with pairing code"
#                              and typed CODE into Hermes Mobile's notification; the app found PORT. Runs only
#                              adb pair 127.0.0.1:PORT CODE: no rish, nothing on the screen. Exit 0 = paired.
#   hm-shizuku start [port]    Needs Wireless debugging on. Connects to 127.0.0.1:<port> (the app finds the port; without
#                              one, or if it doesn't answer, it scans the loopback ports, ~1-20 s) and starts Shizuku's
#                              server. Exit 0 only when shizuku_server runs. Never prompts.
#   hm-shizuku status          Prints "paired" or "unpaired", then "adb=ok" or "adb=missing".
#
# After pair/start it tells the app, like the Hermes plugin does: POST {"kind":"shizuku-auto","cmd":"pair|start",
# "paired":bool,"result":"ok|no-port|failed|not-paired","detail":"…"} to 127.0.0.1:9121/event with the key from
# ~/.hermes-mobile/key (no key: nothing is sent). Every adb call is bounded (timeout) and gets </dev/null.
# Log: ~/.hermes-mobile/hm-shizuku.log.
# Exit: 0 ok, 2 adb missing or Android 10 and older, 6 adb pair failed, 7 no Wireless debugging port, 8 server didn't
# start, 9 not paired, 10 busy, 64 usage.
set -u
HM="$HOME/.hermes-mobile"
MARK="$HM/adb-paired"
LOGF="$HM/hm-shizuku.log"
EVENT_URL="http://127.0.0.1:9121/event"
NAP="${HM_SHIZUKU_NAP:-1}"                      # tests set 0 (no sleeps)
SCAN_FROM="${HM_SCAN_FROM:-32768}"; SCAN_TO="${HM_SCAN_TO:-60999}"   # Linux's ephemeral range (adbd binds port 0)
KEYDIR="${ANDROID_USER_HOME:-$HOME/.android}"
SHIZUKU_PKG=moe.shizuku.privileged.api
CMD="${1:-}"
mkdir -p "$HM"

nap() { [ "$NAP" = 0 ] || sleep "$1"; }
log() {
  echo "hm-shizuku: $*"
  echo "$(date '+%Y-%m-%d %H:%M:%S') $CMD: $*" >> "$LOGF" 2>/dev/null
}
A() { timeout -s KILL "${TO:-10}" adb "$@" </dev/null 2>&1; }   # Termux's adb, bounded
have_adb() { command -v adb >/dev/null 2>&1; }
keysum() { [ -s "$KEYDIR/adbkey.pub" ] && cksum < "$KEYDIR/adbkey.pub" | awk '{print $1}'; }
# Paired = this script (or a start) saw the phone accept the adb key that is in ~/.android now.
paired_now() { local k; k=$(keysum) && [ -n "$k" ] && [ -s "$MARK" ] && [ "$(awk '{print $2}' "$MARK")" = "$k" ]; }
mark_paired() { echo "$(date +%s) $(keysum)" > "$MARK"; }

jstr() {   # JSON string
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=$(printf '%s' "$s" | tr '\n\r\t' '   ' | tr -d '\000-\037')
  printf '"%s"' "$s"
}
emit() {   # emit <result> <detail>: tell the app (best effort, 2 s)
  local key paired=false
  key=$(cat "$HM/key" 2>/dev/null) || return 0
  [ -n "$key" ] && command -v curl >/dev/null 2>&1 || return 0
  paired_now && paired=true
  printf '{"kind":"shizuku-auto","cmd":%s,"paired":%s,"result":%s,"detail":%s}' "$(jstr "$CMD")" "$paired" "$(jstr "$1")" "$(jstr "$2")" |
    curl -s -m 2 -o /dev/null -X POST -H 'Content-Type: application/json' \
      -H @<(printf 'X-Hermes-Mobile-Key: %s\n' "$key") --data-binary @- "$EVENT_URL" 2>/dev/null || true
}
# finish <result> <exit code> <detail>: tell the app, exit.
finish() {
  if [ "$2" = 0 ]; then log "$3"; else log "FAIL ($1) $3"; fi
  emit "$1" "$3"
  exit "$2"
}

cmd_pair() {
  local port="${1:-}" code="${2:-}" out sdk
  [ -n "$port$code" ] || finish failed 64 "update Hermes Mobile: pairing is done from the app now (Setup check → Shizuku starts by itself)"
  [[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] && [[ "$code" =~ ^[0-9]{6}$ ]] || usage
  have_adb || finish failed 2 "adb is missing (pkg install android-tools)"
  sdk=$(getprop ro.build.version.sdk 2>/dev/null)
  [ -n "$sdk" ] && [ "$sdk" -lt 30 ] 2>/dev/null && finish failed 2 "Wireless debugging needs Android 11 or newer: start Shizuku from a computer after a restart"
  A start-server >/dev/null   # makes ~/.android/adbkey on first use
  # Over loopback: the phone pairs with itself, no Wi-Fi address needed.
  out=$(TO=20 A pair "127.0.0.1:$port" "$code")
  echo "$out" | grep -q 'Successfully paired' || finish failed 6 "adb pair failed: $(echo "$out" | tail -1)"
  mark_paired
  finish ok 0 "paired"
}

# ── start ──
SERIAL=""; UNAUTH=""
try_port() {   # connect to 127.0.0.1:<port> and prove it is adbd (shell uid); sets SERIAL
  local s="127.0.0.1:$1" out id
  out=$(TO=6 A connect "$s")
  case "$out" in
    *"connected to"*) ;;
    *authenticat*|*unauthorized*) UNAUTH=1; A disconnect "$s" >/dev/null; return 1 ;;
    *) A disconnect "$s" >/dev/null; return 1 ;;
  esac
  id=$(TO=8 A -s "$s" shell id -u | tr -d '\r')
  [ "$id" = 2000 ] && { SERIAL=$s; return 0; }
  case "$id" in *authenticat*|*unauthorized*) UNAUTH=1 ;; esac
  A disconnect "$s" >/dev/null; return 1
}
# Open loopback ports in the ephemeral range. Termux's adb has no mDNS and apps can't read /proc/net/tcp, so this is
# the only way without the app's port. In-process connects (no fork per port); runs in its own subshell.
scan() { local p=$SCAN_FROM; while [ "$p" -le "$SCAN_TO" ]; do { exec 3<>"/dev/tcp/127.0.0.1/$p"; } 2>/dev/null && { exec 3>&-; echo "$p"; }; p=$((p+1)); done; }
server_up() { TO=8 A -s "$SERIAL" shell ps -A -o NAME | tr -d '\r' | grep -q '^shizuku_server'; }

cmd_start() {
  local port="${1:-}" ports p out i
  [ -z "$port" ] || echo "$port" | grep -Eq '^[0-9]{1,5}$' || usage
  have_adb || finish failed 2 "adb is missing (pkg install android-tools)"
  A start-server >/dev/null
  [ -n "$port" ] && { try_port "$port" || log "port $port: no adbd there, scanning"; }
  if [ -z "$SERIAL" ]; then
    ports=$(scan)
    log "open loopback ports: $(echo $ports)"
    for p in $ports; do [ "$p" = "$port" ] && continue; try_port "$p" && break; done
  fi
  if [ -z "$SERIAL" ]; then
    if [ -n "$UNAUTH" ]; then
      rm -f "$MARK"
      finish not-paired 9 "Wireless debugging refused Termux's adb key: pair again (Setup check → Shizuku starts by itself)"
    fi
    finish no-port 7 "no Wireless debugging port answered (is Wireless debugging on?)"
  fi
  paired_now || mark_paired   # the phone accepted the key: it is paired (also when paired by hand)
  if server_up; then A disconnect "$SERIAL" >/dev/null; finish ok 0 "Shizuku was already running"; fi
  # Shizuku's own adb start command, with whichever ABI folder the phone extracted.
  out=$(TO=30 A -s "$SERIAL" shell 'p=$(pm path '"$SHIZUKU_PKG"' | head -1 | cut -d: -f2); d=$(dirname "$p"); for f in "$d"/lib/*/libshizuku.so; do [ -e "$f" ] && exec "$f"; done; echo "Shizuku is not installed (no libshizuku.so)"; exit 1')
  for i in 1 2 3 4 5; do
    server_up && { A disconnect "$SERIAL" >/dev/null; finish ok 0 "Shizuku started ($SERIAL)"; }
    nap 1
  done
  A disconnect "$SERIAL" >/dev/null
  finish failed 8 "Shizuku's server didn't start: $(echo "$out" | grep . | tail -1)"
}

cmd_status() {
  if paired_now; then echo paired; else echo unpaired; fi
  if have_adb; then echo adb=ok; else echo adb=missing; fi
}

usage() { echo "usage: hm-shizuku pair PORT CODE | start [port] | status" >&2; exit 64; }

# One pair/start at a time (the app may start one while another runs).
lock() {
  local L="$HM/hm-shizuku.lock" pid
  if ! mkdir "$L" 2>/dev/null; then
    pid=$(cat "$L/pid" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && ps -o args= -p "$pid" 2>/dev/null | grep -q hm-shizuku; then log "busy: another hm-shizuku run ($pid) reports the result"; exit 10; fi
    rm -rf "$L"; mkdir "$L" 2>/dev/null || exit 10
  fi
  echo $$ > "$L/pid"
  trap 'rm -rf "'"$L"'"; tail -n 300 "$LOGF" > "$LOGF.tmp" 2>/dev/null && mv "$LOGF.tmp" "$LOGF"' EXIT
}

case "$CMD" in
  pair) [ $# -le 3 ] || usage; lock; cmd_pair "${2:-}" "${3:-}" ;;
  start) [ $# -le 2 ] || usage; lock; cmd_start "${2:-}" ;;
  status) cmd_status ;;
  *) usage ;;
esac
