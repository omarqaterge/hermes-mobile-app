[
  {
    "name": "web_search",
    "description": "Search the web. Returns {success, data: {web: [{url, title, description}]}}; on failure {error}.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "The search query to look up on the web. You may include backend-supported operators such as site:example.com, filetype:pdf, intitle:word, -term, or \"exact phrase\"."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results to return. Defaults to 5.",
          "minimum": 1,
          "maximum": 100,
          "default": 5
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "properties": {
            "web": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "string"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "find_chats",
    "description": "Find the user's chats by words and/or by the images, videos, audio or files in them, newest first. Returns {ok, chats_found, chats: [{id, title, profile, last_active, link, snippets: [{who, snippet}], items: [{kind, path}]}]}.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Words to find (all must appear in one message or the title). Optional."
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio",
            "file",
            "media"
          ],
          "description": "Only chats containing this: image, video, audio, file (documents etc.) or media (any of them). Omit for a text-only search; with neither text nor kind, image is assumed."
        },
        "who": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "any"
          ],
          "description": "user = sent/written by the user, agent = by you (default any)."
        },
        "profile": {
          "type": "string",
          "description": "Profile name, or 'all' (default)."
        },
        "limit": {
          "type": "integer",
          "description": "Max chats to return (default 30)."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "who": {
          "type": "string"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chats_found": {
          "type": "integer"
        },
        "chats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "profile": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "last_active": {
                "type": "number"
              },
              "link": {
                "type": "string"
              },
              "title_match": {
                "type": "boolean"
              },
              "text_hits": {
                "type": "integer"
              },
              "snippets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "msg_id": {
                      "type": "integer"
                    },
                    "who": {
                      "type": "string"
                    },
                    "snippet": {
                      "type": "string"
                    }
                  }
                }
              },
              "from_user": {
                "type": "integer"
              },
              "from_agent": {
                "type": "integer"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "who": {
                      "type": "string"
                    },
                    "how": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "exists": {
                      "type": "boolean"
                    },
                    "canvas": {
                      "type": "string"
                    },
                    "canvas_type": {
                      "type": "string"
                    }
                  }
                }
              },
              "more_items": {
                "type": "integer"
              }
            }
          }
        },
        "more_chats": {
          "type": "integer"
        },
        "unreferenced_uploads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true
    }
  }
]
