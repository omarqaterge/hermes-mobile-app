From 5663e2e88df4d3213d9cf5e6b83a09ee7154ad6d Mon Sep 17 00:00:00 2001
From: omarqaterge <omarqaterge@gmail.com>
Date: Thu, 15 Oct 2026 18:19:18 +0200
Subject: [PATCH] perf(yaml): reuse a per-thread reader in safe_load

Every safe_load built a new ruamel YAML(), whose __init__ globs ruamel's
plug-in directory. On a phone (Termux + proot, Python 3.14) that costs
~7 ms per call against ~0.3 ms for parsing a frontmatter block, so an
uncached skill scan (_find_all_skills, 162 skills) took 1.8 s, holding
the GIL while other gateway RPCs waited.

Each thread now keeps one reader per mode (C / pure). load() resets the
reader, scanner and parser itself; doc_infos is cleared per call so a
reused reader does not grow, and a reader that raised is dropped.
Measured on the phone: 162 frontmatter loads 1197 ms -> 82 ms, uncached
skill scan 1.80 s -> 0.49 s.
---
 hermes_yaml.py            | 22 ++++++++++++++++++----
 tests/test_hermes_yaml.py | 31 +++++++++++++++++++++++++++++++
 2 files changed, 49 insertions(+), 4 deletions(-)

diff --git a/hermes_yaml.py b/hermes_yaml.py
index bae447df10..43ad696dec 100644
--- a/hermes_yaml.py
+++ b/hermes_yaml.py
@@ -1,9 +1,10 @@
 """Shared YAML 1.1 policy for config, manifests, and frontmatter.
 
 Ruamel's native schema includes bare y/n booleans and rejects duplicate keys.
-Every operation owns its parser/emitter; instances must not be shared by threads.
+Instances must not be shared by threads: each thread reuses its own reader, emitters are per operation.
 """
 
+import threading
 from io import StringIO
 from typing import Any, IO, overload
 
@@ -19,10 +20,23 @@ class _Yaml11Resolver(VersionedResolver):
         return (1, 1)
 
 
+# Building a YAML() globs ruamel's plug-in dir (~7 ms on a phone, ~20x the parse of a frontmatter block), and
+# skill scans load hundreds of documents. Each thread keeps one reader per mode; load() resets its parser.
+_parsers = threading.local()
+
+
 def _load(document: str | bytes, *, pure: bool) -> Any:
-    yaml = YAML(typ="safe", pure=pure)
-    yaml.version = (1, 1)
-    return yaml.load(document)
+    cache = _parsers.__dict__.setdefault("by_mode", {})
+    yaml = cache.get(pure)
+    if yaml is None:
+        yaml = cache[pure] = YAML(typ="safe", pure=pure)
+        yaml.version = (1, 1)
+    yaml.doc_infos.clear()  # load() appends one per document: a reused reader must not grow
+    try:
+        return yaml.load(document)
+    except BaseException:
+        cache.pop(pure, None)  # a failed parse may leave state behind: the next load builds afresh
+        raise
 
 
 def safe_load(stream: str | bytes | IO[str] | IO[bytes]) -> Any:
diff --git a/tests/test_hermes_yaml.py b/tests/test_hermes_yaml.py
index d2882d2861..1a72e917f6 100644
--- a/tests/test_hermes_yaml.py
+++ b/tests/test_hermes_yaml.py
@@ -90,3 +90,34 @@ def test_parallel_calls_do_not_share_parser_or_emitter_state():
     with pytest.raises(yaml.YAMLError):
         yaml.safe_dump(object())
     assert yaml.safe_load(yaml.safe_dump({"healthy": True})) == {"healthy": True}
+
+
+def test_safe_load_reuses_one_parser_per_thread_and_mode(monkeypatch):
+    # Building a ruamel YAML() globs its plug-in dir: ~7 ms per call on a phone, ~95% of a frontmatter load.
+    made = []
+    real = yaml.YAML
+
+    def counting(*args, **kwargs):
+        made.append(kwargs.get("pure"))
+        return real(*args, **kwargs)
+
+    monkeypatch.setattr(yaml, "YAML", counting)
+
+    def many():
+        return [yaml.safe_load(f"count: {i}\nflag: on\n") for i in range(50)]
+
+    with ThreadPoolExecutor(1) as pool:  # a fresh thread: nothing cached yet
+        first = pool.submit(many).result()
+    assert first == [{"count": i, "flag": True} for i in range(50)]
+    assert made == [False]
+    first[0]["count"] = "changed"  # results are independent objects
+    with ThreadPoolExecutor(1) as pool:  # another thread builds its own
+        assert pool.submit(yaml.safe_load, "count: 0\n").result() == {"count": 0}
+    assert made == [False, False]
+
+
+def test_safe_load_recovers_after_a_parse_error():
+    for _ in range(3):
+        with pytest.raises(yaml.YAMLError):
+            yaml.safe_load("a: [unclosed\n")
+        assert yaml.safe_load("a: [1, 2]\nb: off\n") == {"a": [1, 2], "b": False}
