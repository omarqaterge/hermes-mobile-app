{
  "description": "Shared canvas open/save path security vectors enforced by both hermes-plugin/hermes-mobile/canvas.py and web/src/canvas.ts (and tools/web-e2e/mock.cjs). {HOME} expands to the test HOME in Python and /root in the web app. Server must be at least as strict as the app on every security rule.",
  "cases": [
    { "path": "{HOME}/notes.md", "open": "allow", "save": "allow", "note": "ordinary file in home" },
    { "path": "{HOME}/projects/site/app.py", "open": "allow", "save": "allow", "note": "nested file in home" },
    { "path": "~/notes.md", "open": "allow", "save": "allow", "note": "tilde-slash home path" },
    { "path": "/sdcard/Documents/plan.md", "open": "allow", "save": "allow", "needsSdcard": true, "note": "file in /sdcard" },
    { "path": "/storage/emulated/0/Download/note.txt", "open": "allow", "save": "allow", "needsSdcard": true, "note": "file in /storage/emulated/0" },

    { "path": "/tmp/log.txt", "open": "allow", "save": "refuse", "note": "outside save roots: read-only open allowed, save refused" },
    { "path": "/etc/hosts", "open": "allow", "save": "refuse", "note": "/etc non-secret text file: read-only open allowed, save refused" },
    { "path": "/storage/1234-5678/notes.md", "open": "allow", "save": "refuse", "note": "removable storage UUID: read-only open allowed, save refused" },
    { "path": "{HOME}/.hermes/config.yaml", "open": "allow", "save": "refuse", "note": "Hermes config: read-only open allowed, save refused" },
    { "path": "{HOME}/.hermes/profiles/work/config.yaml", "open": "allow", "save": "refuse", "note": "Hermes profile config: read-only open allowed, save refused" },

    { "path": "/SDCARD/notes.md", "open": "allow", "save": "refuse", "note": "case-sensitive save root: uppercase /SDCARD refused on save" },
    { "path": "/STORAGE/emulated/0/notes.md", "open": "allow", "save": "refuse", "note": "case-sensitive save root: uppercase /STORAGE refused on save" },
    { "path": "/ROOT/notes.md", "open": "allow", "save": "refuse", "note": "case-sensitive save root: uppercase /ROOT refused on save" },

    { "path": "/home/other/notes.md", "open": "allow", "save": "refuse", "note": "other user's /home not a phone save root" },
    { "path": "/Users/other/notes.md", "open": "allow", "save": "refuse", "note": "other user's /Users not a phone save root" },
    { "path": "/data/data/com.termux/files/home/notes.md", "open": "allow", "save": "refuse", "note": "Termux host home outside proot HOME=/root refused on save" },
    { "path": "/data/user/0/com.termux/files/home/notes.md", "open": "allow", "save": "refuse", "note": "Termux user-0 home outside proot HOME=/root refused on save" },

    { "path": "{HOME}/sub/../notes.md", "open": "allow", "save": "refuse", "note": ".. segment refused on save before normalization" },
    { "path": "{HOME}/notes/../.hermes/config.yaml", "open": "allow", "save": "refuse", "note": ".. traversal to .hermes/config.yaml refused on save" },
    { "path": "~otheruser/notes.md", "open": "refuse", "save": "refuse", "note": "~user expansion refused on both open and save" },
    { "path": "~root/notes.md", "open": "refuse", "save": "refuse", "note": "~root existing-user expansion refused on both open and save" },
    { "path": "{HOME}/bad\u0000.txt", "open": "refuse", "save": "refuse", "note": "NUL byte refused on both open and save" },
    { "path": "relative/file.txt", "open": "refuse", "save": "refuse", "note": "relative path refused on both open and save" },

    { "path": "/data/data/com.termux/files/home/.hermes-mobile/key", "open": "refuse", "save": "refuse", "note": "Termux home .hermes-mobile segment" },
    { "path": "/data/user/0/com.termux/files/home/.hermes-mobile/key", "open": "refuse", "save": "refuse", "note": "Termux user-0 .hermes-mobile segment" },
    { "path": "/data/data/com.termux/files/home/.ssh/id_ed25519", "open": "refuse", "save": "refuse", "note": "Termux home .ssh segment" },
    { "path": "/data/user/0/com.termux/files/home/.gnupg/secring.gpg", "open": "refuse", "save": "refuse", "note": "Termux home .gnupg segment" },
    { "path": "/data/data/com.termux/files/home/.aws/credentials", "open": "refuse", "save": "refuse", "note": "Termux home .aws segment" },
    { "path": "/data/data/com.termux/files/home/.android/adbkey", "open": "refuse", "save": "refuse", "note": "Termux home .android segment" },
    { "path": "/data/data/com.termux/files/home/.termux/termux.properties", "open": "refuse", "save": "refuse", "note": "Termux home .termux segment" },
    { "path": "/data/data/com.termux/files/home/.netrc", "open": "refuse", "save": "refuse", "note": "Termux home .netrc" },
    { "path": "/data/data/com.termux/files/home/.hermes/auth.json", "open": "refuse", "save": "refuse", "note": "Termux home .hermes auth.json" },
    { "path": "/data/data/com.termux/files/home/.hermes/profiles/work/auth.json", "open": "refuse", "save": "refuse", "note": "Termux home profile auth.json" },
    { "path": "/data/data/com.termux/files/home/.hermes/profiles/work/mobile/auto.json", "open": "refuse", "save": "refuse", "note": "Termux home profile mobile/" },
    { "path": "/data/data/com.termux/files/home/.hermes/.env", "open": "refuse", "save": "refuse", "note": "Termux home .hermes/.env" },

    { "path": "/data/data/com.termux/files/usr/var/lib/proot-distro/containers/debian/rootfs/root/.hermes/config.yaml", "open": "refuse", "save": "refuse", "note": "proot-distro container rootfs alias" },
    { "path": "/data/data/com.termux/files/usr/var/lib/proot-distro/containers/debian/rootfs/root/notes.md", "open": "refuse", "save": "refuse", "note": "proot-distro container rootfs any file" },
    { "path": "/data/user/0/com.termux/files/usr/var/lib/chroot-distro/debian/root/.hermes/config.yaml", "open": "refuse", "save": "refuse", "note": "chroot-distro container rootfs alias" },

    { "path": "/proc/self/environ", "open": "refuse", "save": "refuse", "note": "/proc pseudo-fs refused" },
    { "path": "/sys/class/net/lo/address", "open": "refuse", "save": "refuse", "note": "/sys pseudo-fs refused" },
    { "path": "/dev/null", "open": "refuse", "save": "refuse", "note": "/dev refused" },
    { "path": "/etc/ssh/sshd_config", "open": "refuse", "save": "refuse", "note": "/etc/ssh refused" },
    { "path": "/data/data/com.termux/files/usr/etc/ssh/ssh_host_rsa_key", "open": "refuse", "save": "refuse", "note": "Termux PREFIX/etc/ssh refused" },
    { "path": "/data/user/0/com.termux/files/usr/etc/ssh/sshd_config", "open": "refuse", "save": "refuse", "note": "Termux user-0 PREFIX/etc/ssh refused" },

    { "path": "/sdcard/backup/.ssh/id_rsa", "open": "refuse", "save": "refuse", "note": "nested .ssh segment under /sdcard" },
    { "path": "/sdcard/backup/.hermes/auth.json", "open": "refuse", "save": "refuse", "note": "nested .hermes auth.json under /sdcard" },
    { "path": "/sdcard/backup/.hermes/profiles/work/mobile/state.json", "open": "refuse", "save": "refuse", "note": "nested .hermes profile mobile/ under /sdcard" },
    { "path": "/sdcard/app/.ENV.LOCAL", "open": "refuse", "save": "refuse", "note": "case-insensitive .env.* under /sdcard" },
    { "path": "/sdcard/sub/.NetRC", "open": "refuse", "save": "refuse", "note": "case-insensitive nested .netrc" },
    { "path": "{HOME}/.AWS/Credentials", "open": "refuse", "save": "refuse", "note": "case-insensitive .aws segment" },
    { "path": "{HOME}/.Termux/termux.properties", "open": "refuse", "save": "refuse", "note": "case-insensitive .termux segment" },
    { "path": "{HOME}/.hermes/mobile/canvas/s/d.json", "open": "refuse", "save": "refuse", "note": "Hermes mobile/ internal dir" },
    { "path": "{HOME}/.hermes/profiles/work/google_token.json", "open": "refuse", "save": "refuse", "note": "Hermes profile google_token.json" },

    { "path": "{HOME}/sub/.hermes/config.yaml", "open": "allow", "save": "refuse", "note": "nested .hermes under home refused on save" },
    { "path": "/sdcard/.hermes/config.yaml", "open": "allow", "save": "refuse", "needsSdcard": true, "note": "nested .hermes under /sdcard refused on save" },
    { "path": "/sdcard/sub/.Hermes/Config.YAML", "open": "allow", "save": "refuse", "needsSdcard": true, "note": "case-insensitive nested .hermes under /sdcard refused on save" },
    { "path": "{HOME}/sub/.gitconfig", "open": "allow", "save": "refuse", "note": "nested .gitconfig refused on save" },
    { "path": "{HOME}/.GitConfig", "open": "allow", "save": "refuse", "note": "case-insensitive .gitconfig refused on save" },
    { "path": "/sdcard/repo/.config/git/config", "open": "allow", "save": "refuse", "needsSdcard": true, "note": "nested .config/git refused on save" },
    { "path": "/sdcard/sub/.Config/Fish/config.fish", "open": "allow", "save": "refuse", "needsSdcard": true, "note": "case-insensitive nested .config/fish refused on save" },
    { "path": "{HOME}/.local/bin/tool", "open": "allow", "save": "refuse", "note": ".local/bin refused on save" },
    { "path": "/sdcard/sub/bin/run.sh", "open": "allow", "save": "refuse", "needsSdcard": true, "note": "nested bin segment refused on save" },
    { "path": "{HOME}/.bashrc", "open": "allow", "save": "refuse", "note": ".bashrc refused on save" },
    { "path": "{HOME}/.BashRC", "open": "allow", "save": "refuse", "note": "case-insensitive .bashrc refused on save" },
    { "path": "/sdcard/sub/.shinit", "open": "allow", "save": "refuse", "needsSdcard": true, "note": "nested .shinit refused on save" },
    { "path": "{HOME}/.cshrc", "open": "allow", "save": "refuse", "note": ".cshrc refused on save" },
    { "path": "{HOME}/.tcshrc", "open": "allow", "save": "refuse", "note": ".tcshrc refused on save" },
    { "path": "{HOME}/.kshrc", "open": "allow", "save": "refuse", "note": ".kshrc refused on save" }
  ]
}
